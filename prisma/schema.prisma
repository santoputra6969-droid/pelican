generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

// 200 rumah dari data asli Puri Pelican
model House {
  id              Int      @id @default(autoincrement())
  block           String // PLC-1 .. PLC-8
  no              String // nomor rumah (string, mis. "1", "15")
  ownerName       String? // nama pemilik/penghuni (bisa kosong)
  occupied        Boolean  @default(false)
  occupiedByOwner Boolean  @default(false)
  payIpl          Boolean  @default(true)
  iplAmount       Int      @default(252000)
  payCash         Boolean  @default(false)
  cashAmount      Int?
  payPkk          Boolean  @default(false)
  pkkAmount       Int?
  createdAt       DateTime @default(now())
  bills           Bill[]
  residents       Resident[]

  @@unique([block, no])
}

// Tagihan IPL per rumah per bulan
model Bill {
  id            Int      @id @default(autoincrement())
  house         House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  houseId       Int
  year          Int
  month         Int
  amount        Int
  status        String   @default("UNPAID") // UNPAID | PAID
  transactionId Int? // id transaksi journal saat dibayar
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  @@unique([houseId, year, month])
  @@index([status])
}

// Buku kas / jurnal transaksi komunitas (pemasukan & pengeluaran)
model Transaction {
  id           Int      @id @default(autoincrement())
  category     String   @default("UTAMA") // UTAMA | PKK
  type         String? // IPL | KAS | PKK | pengeluaran (Gaji Security, dst)
  idSettlement String?  @unique
  notes        String?
  amount       Int
  mutation     String   @default("DEBIT") // DEBIT (masuk) | KREDIT (keluar)
  image        String?
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}

// Saldo kas cluster (Saldo Utama & Kas PKK)
model Balance {
  id         Int      @id @default(autoincrement())
  balance    Float    @default(0) // Saldo Utama
  balancePkk Float    @default(0) // Saldo Kas PKK
  lastTxId   String?
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
}

// Banner promosi (gambar)
model Banner {
  id        Int      @id @default(autoincrement())
  image     String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
}

// Informasi / pengumuman warga (konten HTML)
model Information {
  id        String   @id @default(cuid())
  legacyId  Int?     @unique
  title     String
  content   String // HTML
  image     String?
  isPin     Boolean  @default(false)
  published Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
}

// Kategori pengeluaran (untuk admin saat catat transaksi)
model TransactionType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdBy String?
  createdAt DateTime @default(now())
}

// Order pembayaran via Midtrans (Snap). Menjembatani klik Bayar -> webhook settlement.
model Payment {
  id            Int      @id @default(autoincrement())
  orderId       String   @unique // order_id yang dikirim ke Midtrans
  houseId       Int
  billIds       String // daftar id tagihan, dipisah koma
  amount        Int // gross_amount
  status        String   @default("PENDING") // PENDING | PAID | EXPIRED | FAILED | CANCEL
  snapToken     String?
  paymentType   String? // qris | bank_transfer | gopay | dst
  fee           Int      @default(0) // biaya MDR Midtrans (jika ada)
  settledAt     DateTime?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([houseId])
}

// Pengaduan / keluhan warga, dikumpulkan & dikelola di dashboard admin.
model Complaint {
  id         Int      @id @default(autoincrement())
  houseId    Int?
  houseLabel String? // snapshot "Blok PLC-1 / No. 5"
  ownerName  String?
  category   String   @default("UMUM") // KEAMANAN | KEBERSIHAN | FASILITAS | LINGKUNGAN | UMUM
  message    String
  status     String   @default("BARU") // BARU | DIPROSES | SELESAI
  reply      String?
  repliedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([houseId])
}

// File terbatas-akses (KTP/KK/arsip/lampiran). Disimpan sebagai bytea di
// Postgres, TIDAK pernah punya URL publik. Hanya disajikan lewat route admin
// yang memvalidasi sesi — aman dari kebocoran karena tidak ter-expose.
model StoredFile {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  kind      String   @default("DOC") // KTP | KK | ARSIP | LAMPIRAN | DOC
  data      Bytes // konten file (bytea)
  createdBy String?
  createdAt DateTime @default(now())

  @@index([kind])
}

// Data anggota rumah (Pemilik / Penghuni) untuk pendataan KK/KTP.
model Resident {
  id           Int      @id @default(autoincrement())
  house        House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  houseId      Int
  role         String   @default("PEMILIK") // PEMILIK | PENGHUNI
  name         String
  phone        String?
  nik          String? // NIK KTP
  familyStatus String? // K0, K1, dst
  active       Boolean  @default(true)
  ktpFileId    String? // -> StoredFile (foto/scan KTP)
  kkFileId     String? // -> StoredFile (foto/scan Kartu Keluarga)
  note         String?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([houseId])
  @@index([role])
}

// Arsip dokumen (laporan keuangan PDF, notulen, dll).
model Archive {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("UMUM") // LAPORAN | NOTULEN | SK | UMUM
  fileId    String // -> StoredFile
  createdBy String?
  createdAt DateTime @default(now())

  @@index([category])
}

// Pengajuan surat dari warga (Surat Pengantar, Domisili, dll).
model LetterRequest {
  id           Int      @id @default(autoincrement())
  houseId      Int?
  houseLabel   String?
  applicant    String // nama pemohon
  phone        String?
  type         String   @default("PENGANTAR") // PENGANTAR | DOMISILI | KETERANGAN | LAINNYA
  purpose      String // keperluan
  status       String   @default("OPEN") // OPEN | DIPROSES | SELESAI | DITOLAK
  note         String? // catatan admin
  resultFileId String? // -> StoredFile (surat jadi PDF)
  handledBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([houseId])
}

// Voting / polling warga.
model Vote {
  id        Int          @id @default(autoincrement())
  question  String
  detail    String?
  active    Boolean      @default(true)
  closesAt  DateTime?
  createdBy String?
  createdAt DateTime     @default(now())
  options   VoteOption[]
  ballots   VoteBallot[]

  @@index([active])
}

model VoteOption {
  id      Int          @id @default(autoincrement())
  vote    Vote         @relation(fields: [voteId], references: [id], onDelete: Cascade)
  voteId  Int
  label   String
  order   Int          @default(0)
  ballots VoteBallot[]

  @@index([voteId])
}

// Satu suara per rumah per voting.
model VoteBallot {
  id        Int        @id @default(autoincrement())
  vote      Vote       @relation(fields: [voteId], references: [id], onDelete: Cascade)
  voteId    Int
  option    VoteOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId  Int
  houseId   Int
  voterName String?
  createdAt DateTime   @default(now())

  @@unique([voteId, houseId])
  @@index([voteId])
}

// Kontribusi / iuran khusus (mis. sumbangan kegiatan).
model Contribution {
  id          String              @id @default(cuid())
  title       String
  description String?
  target      Int? // target dana (opsional)
  active      Boolean             @default(true)
  createdBy   String?
  createdAt   DateTime            @default(now())
  entries     ContributionEntry[]

  @@index([active])
}

model ContributionEntry {
  id             String       @id @default(cuid())
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  contributionId String
  houseId        Int?
  donorName      String?
  amount         Int
  note           String?
  createdBy      String?
  createdAt      DateTime     @default(now())

  @@index([contributionId])
}

