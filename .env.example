# Database — SQLite (file bawaan, di-seed otomatis saat build)
DATABASE_URL="file:./dev.db"

# Rahasia untuk menandatangani sesi admin (JWT).
# WAJIB diganti dengan string acak panjang di produksi (Railway → Variables).
AUTH_SECRET="ganti-dengan-string-acak-yang-panjang-dan-rahasia"

# === Midtrans (Payment Gateway) ===
# Server Key — RAHASIA, jangan pernah commit nilai asli. Ambil dari dashboard
# Midtrans → Settings → Access Keys.
MIDTRANS_SERVER_KEY="Mid-server-xxxxxxxxxxxxxxxx"
# Client Key — boleh tampil di browser (dipakai Snap.js).
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="Mid-client-xxxxxxxxxxxxxxxx"
# "true" untuk mode Production, "false" untuk Sandbox.
MIDTRANS_IS_PRODUCTION="false"

# URL dasar aplikasi (untuk redirect setelah pembayaran selesai).
# Contoh produksi: https://puripelican.com
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
